{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@src/*": ["./src/*"],
      "@SharedLibrary/utils/UserProfile": ["./src/adapters/UserProfile.ts"],
      "@SharedLibrary/utils/Utils": ["./src/adapters/Utils.ts"],
      "@SharedLibrary/Auth/loginfunctions": ["./src/adapters/loginfunctions.ts"],
      "@src/utils/Constants": ["./src/adapters/Constants.ts"],
      "@src/utils/commonService": ["./src/adapters/commonService.ts"],
      "@src/utils/productservices": ["./src/adapters/productservices.ts"],
      "@src/containers/Globalcontext": ["./src/adapters/Globalcontext.tsx"],
      "primereact/toast": ["./src/shims/primereact/toast.tsx"],
      "primereact/confirmdialog": ["./src/shims/primereact/confirmdialog.tsx"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
