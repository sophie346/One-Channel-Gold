# Gold — public / non-secret overrides only. Never put MONGO passwords here.
# Server secrets: GCP Secret Manager `onegold_prod` (local) or K8s `onegold-backend-env` (live).
# Local: pnpm run dev:secrets   (loads GCP secret into process env — no .env.local)

NEXT_PUBLIC_APP_LABEL=one-gold
